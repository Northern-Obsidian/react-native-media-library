{
  "name": "@obsidian_north/react-native-mediastore",
  "version": "2.1.4",
  "description": "Universal high-performance media indexing library for Android (MediaStore) and iOS (Photos Framework)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "expo",
    "mediastore",
    "android",
    "ios",
    "media",
    "indexing",
    "audio",
    "video",
    "images",
    "documents",
    "expo-module",
    "photos",
    "mediastore"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Northern-Obsidian/react-native-media-library.git"
  },
  "bugs": {
    "url": "https://github.com/Northern-Obsidian/react-native-media-library/issues"
  },
  "author": "cadmus_labs",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf build",
    "watch": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build"
  },
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "expo-module.config.json",
    "!**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "expo": "~52.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "expo": ">=52.0.0"
  }
}
